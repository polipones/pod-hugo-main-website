FROM registry01.in.podolee.cz/cache/hugomods/hugo:std-git-0.164.0 AS build

ARG hugo_env=production
ENV HUGO_ENV=${hugo_env}

RUN apk add --no-cache jq python3

COPY ./ ./

RUN git submodule update --init --recursive && \
    sh scripts/fetch_contacts.sh && \
    sh scripts/validate_site.sh public

FROM registry01.in.podolee.cz/cache/library/nginx:mainline-alpine AS deploy

COPY --from=build /src/public /usr/share/nginx/html
